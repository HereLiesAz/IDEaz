<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The core loop - render the project, tap an element, prompt the AI, reload -
        happens entirely inside this app's own WebView and needs no permissions at
        all. POST_NOTIFICATIONS is the only one left, and only so long-running work
        (clone, deploy) can report progress while the app is backgrounded.

        Deliberately removed, and not to be re-added without a target that needs them:
          SYSTEM_ALERT_WINDOW                 - select mode is an in-app Compose layer
          FOREGROUND_SERVICE_MEDIA_PROJECTION - screenshots were Android-target only
          FOREGROUND_SERVICE_SPECIAL_USE      - was the overlay service
          REQUEST_INSTALL_PACKAGES            - was in-app APK sideload / self-update
          BIND_ACCESSIBILITY_SERVICE (x2)     - element inspection + Gemini app bridge
          <queries>                           - only the accessibility bridge needed it
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IDEaz"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.IDEaz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Isolated process so a crash in the main process can still be reported.
            Opt-in: CrashHandler only starts it after the first-run disclosure.
        -->
        <service
            android:name=".services.CrashReportingService"
            android:exported="false"
            android:process=":crash_reporter" />

    </application>

</manifest>
