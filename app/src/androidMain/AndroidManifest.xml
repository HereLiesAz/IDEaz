<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        This is the policy-safe manifest shared by every distribution. The
        GitHub debug/release builds merge their external-AI automation surface
        from src/debug and src/release respectively; the Play build does not.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        The Aive's remote service (HereLiesAz/aive docs/Remote-API.md). The Aive defines this
        signature permission; it is granted only when IDEaz and The Aive share a signing key.
        Never declare it here: a second definition under a different key fails installation.
    -->
    <uses-permission android:name="com.hereliesaz.aive.permission.REMOTE" />

    <queries>
        <package android:name="com.hereliesaz.aive" />
        <package android:name="com.hereliesaz.haive" />
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IDEaz"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.IDEaz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Safe in both distributions: used only when the user explicitly
             shares a staged project/image into another app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!--
            Isolated process so a crash in the main process can still be reported.
            CrashHandler starts it when KEY_REPORT_IDE_ERRORS (default true) is on and a
            GitHub token is stored; the first-run consent flag is not consulted.
        -->
        <service
            android:name=".services.CrashReportingService"
            android:exported="false"
            android:process=":crash_reporter" />

    </application>

</manifest>
